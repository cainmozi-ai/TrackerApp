# Copy this file to .env.local (git-ignored) and fill in your own keys.
# Restart `npx expo start` after changing it.

# USDA FoodData Central: free key from https://fdc.nal.usda.gov/api-key-signup
# Without it the app uses USDA's shared DEMO_KEY, which allows only a handful
# of searches an hour and skips USDA's branded foods.
EXPO_PUBLIC_USDA_API_KEY=

# Google Gemini: powers "Snap a photo" food recognition.
EXPO_PUBLIC_GEMINI_API_KEY=
